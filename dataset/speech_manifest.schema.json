{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamtranslation.local/schemas/speech-manifest.json",
  "title": "SeamTranslation monolingual speech manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dataset_id",
    "dataset_revision",
    "source_url",
    "source_license",
    "audio_path",
    "audio_origin",
    "language",
    "text",
    "normalized_text",
    "speaker_id",
    "duration_seconds",
    "sample_rate",
    "split",
    "content_sha256",
    "original_audio_sha256"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_revision": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_license": {"const": "CC-BY-4.0"},
    "source_subset": {"const": "Hindi"},
    "source_shard": {"type": "string", "minLength": 1},
    "source_row": {"type": "integer", "minimum": 0},
    "audio_path": {"type": "string", "pattern": "^audio/[a-f0-9]{64}\\.wav$"},
    "audio_origin": {"const": "enhanced-real"},
    "language": {"const": "hi"},
    "text": {"type": "string", "minLength": 1},
    "normalized_text": {"type": "string", "minLength": 1},
    "speaker_id": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "sample_rate": {"const": 16000},
    "split": {"enum": ["train", "validation"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "original_audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
